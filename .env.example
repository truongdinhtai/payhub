# Template. Copy to .env and fill in real values. The app boots with placeholders,
# but Google login and Stripe need real keys. .env is gitignored; this file is not.

# --- Database ---
# docker compose uses its own internal db; these only matter for local mvnw runs.
DB_URL=jdbc:postgresql://localhost:5433/payhub
DB_USERNAME=payhub
DB_PASSWORD=payhub

# --- Google OAuth2 (Google Cloud Console > Credentials > OAuth client) ---
# Authorized redirect URI: http://localhost:8080/login/oauth2/code/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Stripe (test mode: Dashboard > Developers) ---
STRIPE_SECRET_KEY=sk_test_...
# From `stripe listen` or the webhook endpoint settings:
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Frontend integration ---
CORS_ALLOWED_ORIGINS=http://localhost:4200
OAUTH2_SUCCESS_REDIRECT=http://localhost:4200/oauth2/callback
